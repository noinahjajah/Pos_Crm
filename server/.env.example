# คัดลอกเป็น .env แล้วแก้ค่า · ห้ามใส่ key จริงในไฟล์นี้

INTERNAL_KEY=change-me-internal-key-0123456789abcdef

# memory = ทดสอบ ไม่ต้องต่อ Supabase · supabase = ใช้ฐานข้อมูลจริง
DATA_MODE=memory

# โหมด memory
JWT_SECRET=dev-only-jwt-secret-please-change-0123456789
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
MOCK_PASSWORD=password123
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# โหมด supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
USERNAME_EMAIL_DOMAIN=pos.local

# gateway
GATEWAY_PORT=8080
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=300
LOGIN_RATE_LIMIT_PER_MIN=10
PROXY_TIMEOUT_MS=10000
IDENTITY_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
POS_URL=http://localhost:3003
PAYMENT_URL=http://localhost:3004
