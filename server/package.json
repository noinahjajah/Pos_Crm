{
  "name": "pos-crm-server",
  "private": true,
  "description": "POS CRM — backend ของ Dev 1: API Gateway + identity (เฟส 1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm --prefix ../web install",
    "dev": "concurrently -n identity,gateway,web -c blue,green,magenta \"npm run dev:identity\" \"npm run dev:gateway\" \"npm --prefix ../web run dev\"",
    "dev:identity": "node --env-file-if-exists=.env --watch identity/server.js",
    "dev:gateway": "node --env-file-if-exists=.env --watch gateway/server.js",
    "start:identity": "node identity/server.js",
    "start:gateway": "node gateway/server.js",
    "test": "node --test \"test/*.test.js\"",
    "tokens": "node identity/tools.mjs tokens",
    "seed:users": "node identity/tools.mjs seed-users"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "http-proxy-middleware": "^3.0.3",
    "jose": "^5.9.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0"
  }
}
