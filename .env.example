
# ร่วมกันทุก service
INTERNAL_KEY=change-me-internal-key-0123456789abcdef

# memory = ยังไม่ต่อ Supabase (เก็บข้อมูลในหน่วยความจำ ออก JWT เอง) · supabase = ใช้ของจริง
DATA_MODE=memory

# JWT
JWT_SECRET=dev-only-jwt-secret-please-change-0123456789
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
# รหัสผ่านของผู้ใช้ทดสอบใน memory mode (owner / manager1 / staff1)
MOCK_PASSWORD=password123
# ใส่รหัสผ่านผิดติดกันกี่ครั้งถึงล็อกบัญชี และล็อกกี่นาที
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Supabase (ใช้เมื่อ DATA_MODE=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
USERNAME_EMAIL_DOMAIN=pos.local

# Gateway
GATEWAY_PORT=8080
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=300
LOGIN_RATE_LIMIT_PER_MIN=10
PROXY_TIMEOUT_MS=10000
# รันนอก docker (npm run dev) ให้ชี้ localhost · ใน docker compose ตั้งให้อัตโนมัติ
IDENTITY_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
POS_URL=http://localhost:3003
PAYMENT_URL=http://localhost:3004
