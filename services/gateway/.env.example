# ===== API Gateway (Dev 1) =====
PORT=8080

# key ลับระหว่าง gateway กับ service — ต้องตรงกับ INTERNAL_KEY ของทุก service
INTERNAL_KEY=change-me-long-random-string

# ตรวจ JWT ของ Supabase: ใส่ SUPABASE_URL อย่างเดียว = ใช้ JWKS (signing key แบบใหม่)
# ถ้าโปรเจกต์ยังใช้ JWT secret แบบเก่า ใส่ SUPABASE_JWT_SECRET เพิ่ม
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWT_SECRET=

# โดเมนเว็บที่เรียก API ได้ (คั่นด้วย ,) — ถ้าเว็บเรียกผ่าน nginx / vite proxy (โดเมนเดียวกัน) เว้นว่างได้
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# อยู่หลัง nginx ของ web 1 ชั้น → 1 (ให้ rate limit นับตาม IP จริง)
TRUST_PROXY=1

# ที่อยู่ service (ค่าเริ่มต้นเป็นชื่อใน docker compose)
IDENTITY_URL=http://identity:3001
CATALOG_URL=http://catalog:3002
POS_URL=http://pos:3003
PAYMENT_URL=http://payment:3004
UPSTREAM_TIMEOUT_MS=10000
