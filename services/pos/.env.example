# pos service :3003 (Dev 3) — copy เป็น .env แล้วใส่ค่าจริง
# INTERNAL_KEY ต้องตรงกับ gateway / identity / catalog / payment
INTERNAL_KEY=change-me-long-random-string
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# ใน docker compose ตั้งให้แล้ว · รันเองบนเครื่องใช้ localhost
IDENTITY_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
