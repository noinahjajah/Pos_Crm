# คัดลอกเป็น web/.env ถ้าต้องการเปลี่ยนค่า (ไม่ใส่ก็ใช้ได้)

# ที่อยู่ API (ค่าเริ่มต้น /api/v1 ผ่าน gateway)
VITE_API_URL=/api/v1
# แสดงปุ่มบัญชีทดสอบในหน้า login (ตอน npm run dev แสดงอยู่แล้ว)
VITE_SHOW_TEST_ACCOUNTS=false

# จอครัวแบบ realtime (Dev 3 · lib/supabase.js) ใช้ anon key เท่านั้น
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
